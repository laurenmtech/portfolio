{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Must be on the domain with Email Routing enabled. Set once the domain is bought.
    "CONTACT_FROM": "contact@example.com"
  },
  // No destination is pinned here, so the address stays out of the public repo.
  // Cloudflare only delivers to addresses verified in Email Routing anyway.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Bursts only: the binding supports 10s or 60s windows. Turnstile does the heavy lifting.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
