---
const links = [
  { href: '/projects', label: 'Work' },
  { href: '/work-with-me', label: 'Services' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
  <a href="/" class="display text-xl font-semibold">Lauren<span class="text-accent">.</span></a>
  <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? 'page' : undefined}
          class="rounded-full px-2.5 py-1.5 text-sm text-ink-2 transition hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 sm:px-3"
        >
          {l.label}
        </a>
      ))
    }
    <a href="/contact" class="btn-primary ml-1 hidden !px-4 !py-2 sm:inline-flex">Start a project</a>
    <button
      type="button"
      id="theme-toggle"
      class="ml-1 grid size-9 place-items-center rounded-full text-ink-2 transition hover:bg-paper-2 hover:text-ink"
      aria-label="Switch to dark theme"
    >
      <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
      </svg>
      <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const sync = () => {
    btn.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
  };
  sync();
  btn.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    sync();
  });
</script>
