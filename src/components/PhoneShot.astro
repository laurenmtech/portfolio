---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className = '', loading = 'lazy' } = Astro.props;
---

<div class:list={['rounded-[2.2rem] border border-slab-line bg-slab p-2 shadow-2xl shadow-black/25', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[300, 600]}
    sizes="(min-width: 640px) 300px, 70vw"
    loading={loading}
    class="block h-auto w-full rounded-[1.7rem]"
  />
</div>
