---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'me');
const github = profile?.data.links.github;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-ink-2 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {year} Lauren. Designed and built by me, obviously.</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a class="hover:text-ink" href="/contact">Contact</a></li>
      {github && <li><a class="hover:text-ink" href={github} rel="me">GitHub</a></li>}
      <li><a class="hover:text-ink" href="https://github.com/laurenmtech/portfolio">Source for this site</a></li>
    </ul>
  </div>
</footer>
