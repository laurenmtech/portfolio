---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const steps = [
  {
    title: 'Talk',
    body: 'A free, no-pressure conversation about what you need, who it\'s for, and what "done" looks like.',
  },
  {
    title: 'Plan',
    body: 'You get a written spec and plan: what I\'ll build, in what order, what it costs to run, and a fixed quote.',
  },
  {
    title: 'Build in the open',
    body: 'A live preview link from the first week, so you see real progress instead of waiting for a big reveal.',
  },
  {
    title: 'Launch',
    body: 'We go live together. Your domain, your accounts, your code, plus a short guide to making simple changes yourself.',
  },
  {
    title: 'Keep growing',
    body: 'I\'m a message away for fixes, new features and second opinions, for as long as you want me.',
  },
];

const afterLaunch = [
  {
    title: 'Pay as you go',
    tag: 'Default',
    body: 'Need a fix, a new page, or a quick question answered? Send a note whenever something comes up. I\'ll tell you what it involves before I start, and you only pay for what you ask for.',
  },
  {
    title: 'Monthly plan',
    tag: 'Optional',
    body: 'A set amount of my time each month, for clients who want someone keeping an eye on things: updates, small improvements, and a regular check-in on what\'s next. Cancel any time.',
  },
];

const promises = [
  ['I don\'t disappear after launch', 'Questions, fixes and new ideas are welcome long after go-live, and you\'ll always know how to reach me.'],
  ['Someone who knows your site', 'No re-explaining. I remember why things were built the way they were, so changes are faster.'],
  ['Plain-language updates', 'No jargon. You always know what\'s done, what\'s next, and why.'],
  ['No lock-in', 'Everything is in your name. You stay because it helps, not because you\'re stuck.'],
  ['Great on every screen', 'Fast on any phone, keyboard and screen-reader friendly, and readable in light and dark.'],
  ['Costs you can predict', 'Free hosting where possible, and hard spending caps on anything metered.'],
];
---

<Base title="Services" description="Lauren builds websites, web apps and AI features, and stays in your corner after launch.">
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
    <p class="eyebrow">Services</p>
    <h1 class="display mt-2 max-w-3xl text-5xl leading-tight font-semibold">
      I'm in your corner, before launch and long after.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-2">
      I work with local businesses, practices, creators and small teams who want a developer they can come
      back to: someone who knows their site, answers their questions, and helps it grow.
    </p>
  </section>

  <section class="mx-auto mt-16 grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-3">
    {
      profile.services.map((s) => (
        <div class="rounded-3xl border border-line bg-paper-2 p-6">
          <h2 class="display text-2xl font-semibold">{s.title}</h2>
          <p class="mt-3 text-ink-2">{s.blurb}</p>
        </div>
      ))
    }
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
    <p class="eyebrow">How it works</p>
    <h2 class="display mt-2 text-4xl font-semibold">From first call to the long run</h2>
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        steps.map((s, i) => (
          <li class="border-t-2 border-accent pt-4">
            <p class="text-sm font-semibold text-accent">Step {i + 1}</p>
            <h3 class="mt-1 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-ink-2">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
    <p class="eyebrow">After launch</p>
    <h2 class="display mt-2 max-w-2xl text-4xl font-semibold">Help when you need it, however suits you</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">
      Launch isn't the finish line. Things break, ideas come up, tools change. Pick whichever kind of help fits,
      and switch whenever you like.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        afterLaunch.map((o) => (
          <div class="rounded-3xl border border-line bg-paper-2 p-6 sm:p-8">
            <div class="flex items-center gap-3">
              <h3 class="display text-2xl font-semibold">{o.title}</h3>
              <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent">{o.tag}</span>
            </div>
            <p class="mt-3 text-ink-2">{o.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-ink-2">
      Either way, you own everything. And I mean it about the long run: I'm still improving{' '}
      <a href="/projects/otherworld-bookshelf" class="text-accent underline underline-offset-2">Otherworld Bookshelf</a>{' '}
      a year after I started it. I'll treat yours the same way.
    </p>
  </section>

  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
    <div class="grid gap-x-12 gap-y-8 rounded-3xl border border-slab-line bg-slab px-6 py-12 text-slab-ink sm:grid-cols-2 sm:px-12">
      <h2 class="display text-3xl font-semibold sm:col-span-2">What you can count on</h2>
      {
        promises.map(([t, b]) => (
          <div>
            <h3 class="font-semibold">{t}</h3>
            <p class="mt-1 opacity-75">{b}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto mt-24 max-w-3xl px-4 sm:px-6">
    <h2 class="display text-4xl font-semibold">Questions people ask</h2>
    <div class="mt-8 divide-y divide-line border-y border-line">
      {
        faq.map(({ data }) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {data.q}
              <span class="text-accent transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-ink-2">{data.a}</p>
          </details>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <a href="/contact" class="btn-primary">Start a project</a>
    </div>
  </section>
</Base>
