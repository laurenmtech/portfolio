---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="display text-8xl font-semibold text-accent">404</p>
    <h1 class="display mt-4 text-3xl font-semibold">This page wandered off.</h1>
    <p class="mt-4 text-ink-2">The link might be old, or it might never have existed.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/projects" class="btn-ghost">See the work</a>
    </div>
  </section>
</Base>
