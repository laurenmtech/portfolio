---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { CONTACT_FORM_ENABLED } from '../config';
---

<Base title="Contact" description="Start a project with Lauren, or just say hi.">
  <section class="mx-auto grid max-w-6xl gap-12 px-4 pt-10 sm:px-6 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="display mt-2 text-5xl leading-tight font-semibold">Let's talk about your project</h1>
      <p class="mt-6 text-lg text-ink-2">
        Starting something new, or need a hand with something you already have? A few sentences is plenty:
        what it is, who it's for, and any deadline. I'll reply by email.
      </p>
      <ul class="mt-8 space-y-3 text-ink-2">
        <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✦</span> Your message comes straight to me, not a sales team.</li>
        <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✦</span> This site doesn't save your message. It's emailed straight to me.</li>
        <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✦</span> No newsletter, no follow-up sequence.</li>
      </ul>
    </div>

    {
      CONTACT_FORM_ENABLED ? (
        <ContactForm />
      ) : (
        <div class="rounded-3xl border border-line bg-paper-2 p-6 sm:p-8">
          <p class="display text-6xl text-accent" aria-hidden="true">✦</p>
          <h2 class="display mt-4 text-3xl font-semibold">The form is almost ready</h2>
          <p class="mt-3 text-ink-2">
            I'm finishing the last setup steps so messages reach me reliably. Check back in a few days.
          </p>
          <a href="/work-with-me" class="btn-ghost mt-6">See how I work</a>
        </div>
      )
    }
  </section>
</Base>
