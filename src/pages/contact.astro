---
import Base from '../layouts/Base.astro';
---

<!-- Placeholder until M2 wires up /api/contact. -->
<Base title="Contact" description="Start a project with Lauren.">
  <section class="mx-auto max-w-2xl px-4 pt-10 sm:px-6">
    <p class="eyebrow">Contact</p>
    <h1 class="display mt-2 text-5xl font-semibold">Let's talk about your project</h1>
    <p class="mt-6 text-lg text-ink-2">
      The contact form is almost ready. Check back in a few days, and thanks for your patience.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/work-with-me" class="btn-ghost">How I work</a>
      <a href="/projects" class="btn-ghost">See the work</a>
    </div>
  </section>
</Base>
