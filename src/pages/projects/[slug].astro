---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhoneShot from '../../components/PhoneShot.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, role, stack, links, cover, coverAlt, highlights, status } = project.data;
const { Content } = await render(project);

const all = await getProjects();
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
---

<Base title={title} description={tagline}>
  <article class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
    <a href="/projects" class="text-sm text-ink-2 hover:text-ink">← All work</a>

    <header class="mt-6 grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="eyebrow">{status === 'live' ? 'Live project' : status === 'in-progress' ? 'In progress' : 'Archived'}</p>
        <h1 class="display mt-2 text-5xl leading-tight font-semibold sm:text-6xl">{title}</h1>
        <p class="mt-4 text-xl text-ink-2">{tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {links.live && <a href={links.live} class="btn-primary">Open the app ↗</a>}
          {links.repo && <a href={links.repo} class="btn-ghost">View the code</a>}
        </div>
      </div>
      {cover && <PhoneShot src={cover} alt={coverAlt} loading="eager" class="mx-auto w-60 rotate-2 sm:w-64" />}
    </header>

    <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_280px]">
      <div class="prose-case">
        <Content />
      </div>

      <aside class="order-first space-y-8 lg:order-none">
        <div class="lg:sticky lg:top-8 lg:space-y-8">
          {
            highlights.length > 0 && (
              <div class="rounded-2xl border border-line bg-paper-2 p-5">
                <h2 class="text-xs font-semibold tracking-[0.18em] text-ink-2 uppercase">Highlights</h2>
                <ul class="mt-3 space-y-2.5 text-sm">
                  {highlights.map((h) => (
                    <li class="flex gap-2">
                      <span class="text-accent" aria-hidden="true">✦</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <dl class="mt-8 space-y-5 text-sm lg:mt-0">
            <div>
              <dt class="text-xs font-semibold tracking-[0.18em] text-ink-2 uppercase">My role</dt>
              <dd class="mt-1">{role}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold tracking-[0.18em] text-ink-2 uppercase">Built with</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">
                {stack.map((s) => <span class="rounded-full border border-line px-2.5 py-0.5 text-xs">{s}</span>)}
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>

    {
      next && next.id !== project.id && (
        <a href={`/projects/${next.id}`} class="group mt-20 block rounded-3xl border border-line p-8 transition hover:border-ink-2">
          <p class="eyebrow">Next project</p>
          <p class="display mt-2 text-3xl font-semibold group-hover:text-accent">{next.data.title} →</p>
          <p class="mt-1 text-ink-2">{next.data.tagline}</p>
        </a>
      )
    }
  </article>
</Base>
