---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Work" description="Apps and sites Lauren has designed and built.">
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
    <p class="eyebrow">Work</p>
    <h1 class="display mt-2 text-5xl font-semibold">Things I've shipped</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">
      Each one is live, so you can open it on your phone right now. Every write-up covers what I built
      and the decisions behind it.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
